# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CLASSIFIER_MODEL=gpt-4o
OPENAI_DEFAULT_ANALYZER_MODEL=gpt-4o-mini
OPENAI_ESCALATION_ANALYZER_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=2000

# --- Azure Document Intelligence (OCR) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=60

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
SUPABASE_JWT_SECRET=...
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_SIGNED_URL_TTL=300

# --- RevenueCat ---
# Configure this exact value as the webhook Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_AUTH=Bearer change-me
# Server-side REST API key for GET /subscribers/{app_user_id}.
REVENUECAT_API_KEY=sk_rc_...
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1

# --- Push notifications ---
# Send this value as X-Cron-Secret from the scheduled notification job.
INTERNAL_CRON_SECRET=change-me
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# --- OAMP tracking ---
OAMP_BASE_URL=https://ipc.gov.cz
OAMP_STATUS_PATH=/informace-o-stavu-rizeni/
OAMP_STATUS_PATH_EN=/en/status-of-your-application/
OAMP_TIMEOUT_SECONDS=60
OAMP_USER_AGENTS=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36,Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0.0.0 Safari/537.36

# --- RAG ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.50
EMBEDDING_MAX_CHARS=20000

# --- OCR quality gate ---
MIN_OCR_CONFIDENCE=0.3

# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
LOG_LEVEL=INFO

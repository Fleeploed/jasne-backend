{
  "info": {
    "name": "Jasně API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN"
    },
    {
      "key": "supabase_url",
      "value": "https://xxxxxxxxxxxx.supabase.co"
    },
    {
      "key": "anon_key",
      "value": "YOUR_ANON_KEY"
    }
  ],
  "item": [
    {
      "name": "Auth (Supabase)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{supabase_url}}/auth/v1/signup",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.cz\",\n  \"password\": \"TestPass123!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.collectionVariables.set('user_id', json.user.id);",
                  "  console.log('Token saved:', json.access_token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.cz\",\n  \"password\": \"TestPass123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"cs\",\n  \"has_datova_schranka\": false,\n  \"display_name\": \"Test User\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Scans",
      "item": [
        {
          "name": "Upload Image to Storage",
          "request": {
            "method": "POST",
            "url": "{{supabase_url}}/storage/v1/object/documents/{{user_id}}/doc.jpg",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "image/jpeg" }
            ],
            "body": {
              "mode": "file",
              "file": { "src": "" }
            }
          }
        },
        {
          "name": "Create Scan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('scan_id', json.id);",
                  "  console.log('Scan ID saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/scans",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_path\": \"{{user_id}}/doc.jpg\",\n  \"language\": \"cs\"\n}"
            }
          }
        },
        {
          "name": "List Scans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/scans?limit=20&offset=0",
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Get Scan by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/scans/{{scan_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Deadlines",
      "item": [
        {
          "name": "List Deadlines (active)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/deadlines?only_active=true",
              "query": [
                { "key": "only_active", "value": "true" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "List Deadlines (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/deadlines?only_active=false",
              "query": [
                { "key": "only_active", "value": "false" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Create Deadline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('deadline_id', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/deadlines",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zaplatit fakturu\",\n  \"description\": \"Faktura č. 2026/042\",\n  \"due_date\": \"2026-05-15\",\n  \"deadline_type\": \"payment\",\n  \"reminder_days\": [30, 14, 7, 1]\n}"
            }
          }
        },
        {
          "name": "Update Deadline",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/deadlines/{{deadline_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        },
        {
          "name": "Delete Deadline",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/deadlines/{{deadline_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    }
  ]
}

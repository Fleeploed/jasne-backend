{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "project": "Jasne backend",
    "snapshot_date": "2026-05-27",
    "repo": "https://github.com/Fleeploed/jasne-backend",
    "default_branch": "develop",
    "current_branch": "develop",
    "current_commit": "54541b3",
    "current_version": "0.1.0",
    "phase": "MVP backend on Render Free with scan/chat streaming, PDF input, Help CMS, RevenueCat sync, and OAMP status lookup"
  },
  "deployment": {
    "live_url": "https://jasne-backend.onrender.com",
    "hosting": {
      "service": "Render",
      "service_name": "jasne-backend",
      "plan": "free",
      "region": "frankfurt",
      "config_file": "render.yaml",
      "runtime": "docker",
      "branch_tracked": "develop",
      "auto_deploy_on_push": true,
      "healthcheck_path": "/health",
      "port": "10000",
      "web_concurrency": "1",
      "notes": [
        "Render deploys from the connected GitHub repo; there is no SSH/git pull flow.",
        "Free service can spin down when idle, so first request after idle may be slow.",
        "Railway deploy commands were removed from GitHub Actions."
      ]
    },
    "railway_status": {
      "active": false,
      "old_url": "https://jasne-backend-production.up.railway.app",
      "left_in_code_only_as_fallback": ["RAILWAY_GIT_COMMIT_SHA"],
      "secrets_to_remove_from_github_if_present": [
        "RAILWAY_TOKEN_STAGING",
        "RAILWAY_TOKEN_PRODUCTION"
      ]
    },
    "required_render_env": {
      "configured_in_render_dashboard": [
        "OPENAI_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_KEY",
        "SUPABASE_JWT_SECRET",
        "REVENUECAT_WEBHOOK_AUTH",
        "REVENUECAT_API_KEY"
      ],
      "non_secret_defaults_in_render_yaml": [
        "PORT",
        "WEB_CONCURRENCY",
        "ENVIRONMENT",
        "ALLOWED_ORIGINS",
        "LOG_LEVEL",
        "OPENAI_CLASSIFIER_MODEL",
        "OPENAI_DEFAULT_ANALYZER_MODEL",
        "OPENAI_ESCALATION_ANALYZER_MODEL",
        "OPENAI_CHAT_MODEL",
        "OPENAI_EMBEDDING_MODEL",
        "OPENAI_EMBEDDING_DIMS",
        "OPENAI_TIMEOUT_SECONDS",
        "OPENAI_MAX_RETRIES",
        "OPENAI_MAX_OUTPUT_TOKENS",
        "OPENAI_CLASSIFIER_MAX_OUTPUT_TOKENS",
        "SUPABASE_STORAGE_BUCKET",
        "SUPABASE_SIGNED_URL_TTL",
        "REVENUECAT_ENTITLEMENT_ID",
        "REVENUECAT_API_BASE_URL",
        "RAG_TOP_K",
        "RAG_SIMILARITY_THRESHOLD",
        "EMBEDDING_MAX_CHARS",
        "MIN_OCR_CONFIDENCE"
      ],
      "optional": ["DEEPL_API_KEY", "RENDER_STAGING_URL", "UPTIME_URL"]
    }
  },
  "infrastructure": {
    "database": {
      "service": "Supabase",
      "project_id": "ndestbxknbgaxxdjoqkv",
      "name": "Jasne",
      "region": "eu-west-1",
      "postgres_version": "17",
      "extensions": ["vector (pgvector)", "pgcrypto"],
      "schema_version": "0011_help_admin",
      "migration_files": [
        "0001_init.sql",
        "0002_skill_overhaul.sql",
        "0003_atomic_usage_counters.sql",
        "0004_relax_rag_similarity_threshold.sql",
        "0005_scan_page_count_pdf.sql",
        "0006_list_scans_with_activity.sql",
        "0007_revenuecat_subscription.sql",
        "0008_cascade_delete_scans.sql",
        "0009_keep_usage_on_scan_delete.sql",
        "0010_pro_usage_subscription_period.sql",
        "0011_help_admin.sql"
      ],
      "rls_enabled": true,
      "tier": "Free"
    },
    "storage": {
      "service": "Supabase Storage",
      "bucket": "documents",
      "public": false,
      "path_policy": "object paths must start with the authenticated user id",
      "signed_url_ttl_seconds": 300
    },
    "ci_cd": {
      "platform": "GitHub Actions",
      "workflow": ".github/workflows/ci.yml",
      "stages": [
        "lint (ruff check + ruff format --check)",
        "test on Python 3.11 and 3.12",
        "build and push Docker image to GHCR on push",
        "verify Render staging by polling /version and running smoke test"
      ],
      "production_stage": "defined but disabled until a separate Render production service exists",
      "latest_successful_push_run": {
        "run_id": 26537054851,
        "commit": "54541b3",
        "url": "https://github.com/Fleeploed/jasne-backend/actions/runs/26537054851"
      }
    },
    "monitoring": {
      "github_actions_uptime": {
        "workflow": ".github/workflows/uptime.yml",
        "enabled": true,
        "interval_minutes": 5,
        "endpoint": "https://jasne-backend.onrender.com/health/deep",
        "override_variable": "UPTIME_URL",
        "alert_channel": "GitHub email on failure"
      },
      "render_healthcheck": {
        "endpoint": "/health",
        "purpose": "cheap liveness only; does not call Supabase or OpenAI"
      },
      "deep_health": {
        "endpoint": "/health/deep",
        "purpose": "readiness check for Supabase and OpenAI; intended for external monitors, not platform restart healthchecks"
      }
    }
  },
  "backend": {
    "stack": {
      "language": "Python 3.12 runtime image",
      "framework": "FastAPI 0.136.0",
      "uvicorn": "0.44.0",
      "pydantic": "2.13.2",
      "pydantic_settings": "2.13.1",
      "openai_sdk": "2.32.0",
      "supabase_py": "2.28.3",
      "pyjwt": "2.10.1 [crypto]",
      "httpx": "0.28.1",
      "pymupdf": ">=1.24.0,<2.0.0",
      "playwright": "1.59.0"
    },
    "routers": {
      "system": [
        { "method": "GET", "path": "/health", "auth": false, "purpose": "liveness" },
        { "method": "GET", "path": "/health/deep", "auth": false, "purpose": "Supabase + OpenAI readiness" },
        { "method": "GET", "path": "/version", "auth": false, "purpose": "deployment SHA verification" },
        { "method": "GET", "path": "/docs", "auth": false, "purpose": "Swagger UI outside production" }
      ],
      "profile": [
        { "method": "GET", "path": "/profile", "auth": true },
        { "method": "PUT", "path": "/profile", "auth": true, "note": "plan is owned by RevenueCat and is not user-updatable" }
      ],
      "scans": [
        { "method": "POST", "path": "/scans", "auth": true, "supports": ["png", "jpg", "jpeg", "gif", "webp", "pdf"] },
        { "method": "POST", "path": "/scans/stream", "auth": true, "purpose": "SSE scan progress with keep-alive heartbeats" },
        { "method": "GET", "path": "/scans", "auth": true, "purpose": "paginated scan list via list_scans_with_activity RPC" },
        { "method": "GET", "path": "/scans/counts", "auth": true, "purpose": "total and per-category counts for filter chips" },
        { "method": "GET", "path": "/scans/{scan_id}", "auth": true },
        { "method": "GET", "path": "/scans/{scan_id}/image-urls", "auth": true, "purpose": "signed file URLs; can render PDF previews" },
        { "method": "DELETE", "path": "/scans", "auth": true, "purpose": "bulk delete scans/messages/deadlines without resetting usage quota" },
        { "method": "DELETE", "path": "/scans/{scan_id}", "auth": true, "purpose": "delete one scan; cascades messages and linked deadlines" }
      ],
      "chat": [
        { "method": "GET", "path": "/scans/{scan_id}/chat", "auth": true, "purpose": "thread history" },
        { "method": "POST", "path": "/scans/{scan_id}/chat", "auth": true, "pro_only": true, "max_per_scan": 10 },
        { "method": "POST", "path": "/scans/{scan_id}/chat/stream", "auth": true, "pro_only": true, "purpose": "SSE answer streaming" }
      ],
      "deadlines": [
        { "method": "GET", "path": "/deadlines", "auth": true },
        { "method": "GET", "path": "/deadlines/{deadline_id}", "auth": true },
        { "method": "POST", "path": "/deadlines", "auth": true },
        { "method": "PATCH", "path": "/deadlines/{deadline_id}", "auth": true },
        { "method": "DELETE", "path": "/deadlines/{deadline_id}", "auth": true }
      ],
      "limits": [
        { "method": "GET", "path": "/limits", "auth": true, "purpose": "usage vs plan caps" },
        { "method": "GET", "path": "/limits?scan_id=<uuid>", "auth": true, "purpose": "also returns chat usage for that scan" }
      ],
      "help": [
        { "method": "GET", "path": "/help/home", "auth": true },
        { "method": "GET", "path": "/help/categories/{slug}", "auth": true },
        { "method": "GET", "path": "/help/guides/{slug}", "auth": true },
        { "method": "GET", "path": "/help/search", "auth": true }
      ],
      "admin": [
        { "method": "POST", "path": "/admin/translate", "auth": "admin profile role", "purpose": "DeepL proxy for help-admin" },
        { "method": "GET", "path": "/admin/translate/usage", "auth": "admin profile role", "purpose": "DeepL usage proxy" }
      ],
      "status": [
        { "method": "POST", "path": "/status/oamp", "auth": true, "purpose": "OAMP/IPC case status lookup through Playwright" }
      ],
      "webhooks": [
        { "method": "POST", "path": "/webhooks/revenuecat", "auth": "RevenueCat Authorization header", "purpose": "sync subscription entitlement into profiles" }
      ]
    },
    "core_flows": {
      "scan_pipeline": [
        "validate user-owned Supabase storage paths",
        "sign image URLs or render PDFs to PNG data URLs with PyMuPDF",
        "check plan quota after final page count is known",
        "GPT-4o Vision OCR/classification",
        "pgvector RAG retrieval",
        "category-routed analyzer",
        "persist scan",
        "increment usage counter",
        "best-effort auto-deadlines and chat thread seed"
      ],
      "streaming_scan": {
        "events": ["status", "field", "done", "error"],
        "heartbeats": "SSE comments every 10 seconds during blocking calls"
      },
      "chat": {
        "model": "gpt-4o-mini",
        "context": "scan OCR/result, message history, and RAG snippets",
        "streaming": true,
        "free_plan": "blocked with 402"
      },
      "oamp_status": {
        "source": "https://ipc.gov.cz/informace-o-stavu-rizeni/",
        "english_source": "https://ipc.gov.cz/en/status-of-your-application/",
        "implementation": "Playwright Chromium in a worker thread",
        "supported": "proceedings fields / formatted OAM case number",
        "not_supported_yet": "ZOV visa-number lookup selectors"
      },
      "help": {
        "content_model": "categories and UI strings from YAML; published guides from Postgres help_guides",
        "admin_ui": "help-admin/index.html",
        "admin_role": "profiles.role = admin"
      }
    },
    "ai_models": {
      "openai_classifier_model": "gpt-4o",
      "openai_default_analyzer_model": "gpt-4o-mini",
      "openai_escalation_analyzer_model": "gpt-4o",
      "openai_chat_model": "gpt-4o-mini",
      "openai_embedding_model": "text-embedding-3-small",
      "openai_embedding_dims": 1536,
      "escalation_categories": ["danove", "cizinecka", "soudni"]
    },
    "plan_limits": {
      "free": {
        "monthly_scans": 5,
        "max_pages_per_scan": 3,
        "max_questions_per_scan": 0
      },
      "pro": {
        "monthly_scans": 100,
        "max_pages_per_scan": 10,
        "max_questions_per_scan": 10,
        "usage_period": "subscription period derived from RevenueCat expiration when available"
      }
    },
    "database_schema": {
      "tables": {
        "profiles": ["id", "display_name", "language", "has_datova_schranka", "plan", "subscription_product_id", "subscription_expires_at", "subscription_will_renew", "role", "created_at", "updated_at"],
        "scans": ["id", "user_id", "image_paths", "page_count", "ocr_text", "category", "doc_type", "category_confidence", "result", "language", "model_used", "created_at"],
        "scan_messages": ["id", "scan_id", "user_id", "role", "content", "message_type", "created_at"],
        "deadlines": ["id", "user_id", "scan_id", "title", "description", "due_date", "reminder_days", "deadline_type", "status", "auto_created", "created_at"],
        "usage_limits": ["user_id", "month", "scans_count", "questions_per_scan"],
        "knowledge_chunks": ["id", "content", "metadata", "embedding"],
        "revenuecat_events": ["event_id", "event_type", "app_user_id", "processed_at"],
        "help_categories": ["slug", "title", "icon", "sort_order", "created_at", "updated_at"],
        "help_guides": ["id", "slug", "category_slug", "language", "status", "title", "subtitle", "short_summary", "keywords", "official_source_url", "sections", "sort_order", "created_at", "updated_at"]
      },
      "rpc_functions": [
        "match_knowledge_chunks(query_embedding, filter_category, threshold, count)",
        "increment_scan_count(p_user_id, p_month)",
        "increment_chat_count(p_user_id, p_scan_id, p_month)",
        "list_scans_with_activity(p_user_id, p_limit, p_offset)",
        "delete_user_scans(p_user_id)"
      ],
      "important_constraints": [
        "usage_limits.month accepts YYYY-MM and pro:start:end subscription-period keys",
        "deadlines.scan_id cascades on scan delete",
        "bulk scan delete does not reset usage_limits after migration 0009"
      ]
    },
    "tests": {
      "framework": "pytest + pytest-asyncio",
      "test_files": 21,
      "collected_tests": 310,
      "local_latest": {
        "date": "2026-05-27",
        "command": "venv/bin/python -m pytest",
        "result": "310 passed in 4.31s",
        "local_python": "3.14.4"
      },
      "lint_latest": {
        "date": "2026-05-27",
        "command": "venv/bin/python -m ruff check app tests scripts",
        "result": "All checks passed"
      },
      "coverage_areas": [
        "auth",
        "config",
        "health/version",
        "classifier",
        "analyzer",
        "RAG helpers",
        "limits",
        "RevenueCat",
        "scan routes",
        "chat routes",
        "deadline routes",
        "profile routes",
        "help routes/search/loader",
        "OAMP status route/service",
        "schemas",
        "validator",
        "knowledge loader"
      ]
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "project": "Jasně backend",
    "snapshot_date": "2026-05-02",
    "live_url": "https://jasne-backend-production.up.railway.app",
    "repo": "https://github.com/Fleeploed/jasne-backend",
    "default_branch": "develop",
    "current_version": "0.1.0",
    "phase": "MVP backend with scan/chat streaming, PDF input, and cizinecka RAG loaded"
  },

  "infrastructure": {
    "hosting": {
      "service": "Railway",
      "project": "jasne-backend-staging",
      "environment": "production (single env, prod-prod separation deferred)",
      "branch_tracked": "develop",
      "wait_for_ci": true,
      "auto_deploy_on_push": true,
      "region": "europe-west4-drams3a",
      "trial_days_left": 28,
      "estimated_monthly_cost": "$5-15 USD"
    },
    "database": {
      "service": "Supabase",
      "project_id": "ndestbxknbgaxxdjoqkv",
      "name": "Jasne",
      "region": "eu-west-1",
      "postgres_version": "17",
      "extensions": ["vector (pgvector)", "pgcrypto"],
      "schema_version": "0005_scan_page_count_pdf",
      "rls_enabled": true,
      "tier": "Free"
    },
    "storage": {
      "service": "Supabase Storage",
      "bucket": "documents",
      "public": false,
      "rls_pattern": "auth.uid() = (storage.foldername(name))[1]",
      "signed_url_ttl_seconds": 300
    },
    "ci_cd": {
      "platform": "GitHub Actions",
      "workflow": ".github/workflows/ci.yml",
      "stages": [
        "lint (ruff)",
        "test 3.11 + 3.12 (pytest, 192 tests)",
        "build & push Docker (GHCR)",
        "deploy → staging (Railway)",
        "manual Railway production deploy from develop"
      ],
      "smoke_test_after_deploy": true,
      "uptime_check": ".github/workflows/uptime.yml — every 5 min"
    },
    "monitoring": {
      "github_actions_uptime": {
        "enabled": true,
        "interval_minutes": 5,
        "endpoint": "/health/deep",
        "alert_channel": "GitHub email on failure"
      },
      "uptimerobot": {
        "enabled": true,
        "type": "Keyword (free plan)",
        "endpoint": "/health/deep",
        "keyword": "\"status\":\"ok\"",
        "interval_minutes": 5,
        "alert_channel": "Email"
      },
      "railway_healthcheck": {
        "endpoint": "/health",
        "timeout_seconds": 30,
        "restart_policy": "ON_FAILURE",
        "max_retries": 3
      }
    },
    "secrets_configured": {
      "OPENAI_API_KEY": true,
      "SUPABASE_URL": true,
      "SUPABASE_SERVICE_KEY": true,
      "SUPABASE_JWT_SECRET": true,
      "RAILWAY_TOKEN_STAGING": true,
      "RAILWAY_TOKEN_PRODUCTION": false
    }
  },

  "backend": {
    "stack": {
      "language": "Python 3.12",
      "framework": "FastAPI 0.115",
      "pydantic": "2.9 (v2 with protected_namespaces=())",
      "openai_sdk": "1.51",
      "supabase_py": "2.9 (async)",
      "pyjwt": "2.9 [crypto] for ES256/RS256"
    },
    "endpoints": {
      "system": [
        { "method": "GET", "path": "/health", "auth": false, "purpose": "liveness — Railway healthcheck" },
        { "method": "GET", "path": "/health/deep", "auth": false, "purpose": "readiness — Supabase + OpenAI ping" },
        { "method": "GET", "path": "/docs", "auth": false, "purpose": "Swagger UI" },
        { "method": "GET", "path": "/openapi.json", "auth": false, "purpose": "OpenAPI schema" }
      ],
      "profile": [
        { "method": "GET", "path": "/profile", "auth": true },
        { "method": "PUT", "path": "/profile", "auth": true, "note": "plan field NOT updatable here (RevenueCat webhook)" }
      ],
      "limits": [
        { "method": "GET", "path": "/limits", "auth": true, "purpose": "current usage vs plan caps (mobile gates UI)" },
        { "method": "GET", "path": "/limits?scan_id=<uuid>", "auth": true, "purpose": "+chat questions used for that scan" }
      ],
      "scans": [
        { "method": "POST", "path": "/scans", "auth": true, "body": "{image_paths: string[], language?: string}", "pipeline_seconds": "5-20", "supports": ["jpeg", "png", "gif", "webp", "pdf"] },
        { "method": "POST", "path": "/scans/stream", "auth": true, "body": "{image_paths: string[], language?: string}", "purpose": "SSE scan progress: preparing_inputs, ocr, rag, analysis, saving, done" },
        { "method": "GET", "path": "/scans?limit&offset", "auth": true },
        { "method": "GET", "path": "/scans/{scan_id}", "auth": true },
        { "method": "DELETE", "path": "/scans/{scan_id}", "auth": true, "cascade": "scan_messages deleted, deadlines kept (scan_id → null)" }
      ],
      "chat": [
        { "method": "GET", "path": "/scans/{scan_id}/chat", "auth": true, "purpose": "thread history (image, result_card, text Q&A)" },
        { "method": "POST", "path": "/scans/{scan_id}/chat", "auth": true, "pro_only": true, "max_per_scan": 10, "response_seconds": "3-8" },
        { "method": "POST", "path": "/scans/{scan_id}/chat/stream", "auth": true, "pro_only": true, "purpose": "SSE token streaming for gradual GPT answer" }
      ],
      "deadlines": [
        { "method": "GET", "path": "/deadlines?only_active=bool", "auth": true },
        { "method": "GET", "path": "/deadlines/{deadline_id}", "auth": true },
        { "method": "POST", "path": "/deadlines", "auth": true, "auto_created": false },
        { "method": "PATCH", "path": "/deadlines/{deadline_id}", "auth": true },
        { "method": "DELETE", "path": "/deadlines/{deadline_id}", "auth": true }
      ]
    },
    "services": {
      "classifier": "GPT-4o Vision, multi-page (1-10), detail:high, OCR + classification",
      "analyzer": "GPT-4o or GPT-4o-mini routed by category (escalation: danove/cizinecka/soudni)",
      "chat": "GPT-4o-mini, full history replay, scan OCR/result/history included, 10 questions/scan limit",
      "rag": "pgvector top-5 chunks + keyword exact-address fallback, similarity > 0.50, filter by category, preferred language ordering for chat",
      "embeddings": "text-embedding-3-small (1536 dims)",
      "model_router": "ESCALATION_CATEGORIES = {danove, cizinecka, soudni}",
      "validator": "drops past dates, > 3y dates, invalid types, empty descriptions",
      "limits": "PLAN_LIMITS dict + composite-PK usage_limits table"
    },
    "ai_models": {
      "openai_classifier_model": "gpt-4o (NEVER mini for vision — 33× more expensive on image tokens)",
      "openai_default_analyzer_model": "gpt-4o-mini",
      "openai_escalation_analyzer_model": "gpt-4o (target: gpt-5.4-mini when available)",
      "openai_chat_model": "gpt-4o-mini",
      "openai_embedding_model": "text-embedding-3-small"
    },
    "prompts": {
      "language": "Czech (matches RAG knowledge base + Czech docs)",
      "structure": "1 file per concern in app/prompts/",
      "files": [
        "classifier.py", "base.py", "chat.py",
        "danove.py", "socialni.py", "zdravotni.py", "cizinecka.py",
        "smlouvy.py", "ucty.py", "soudni.py", "urad_prace.py",
        "skolstvi.py", "ostatni.py"
      ],
      "category_count": 10
    },
    "database_schema": {
      "tables": {
        "profiles": ["id", "display_name", "language(cs/en/uk/ru)", "has_datova_schranka", "plan(free/pro)", "created_at", "updated_at"],
        "scans": ["id", "user_id", "image_paths(text[], 1-10)", "page_count(generated)", "ocr_text", "category(10 enum)", "doc_type", "category_confidence", "result(jsonb)", "language", "model_used", "created_at"],
        "scan_messages": ["id", "scan_id", "user_id", "role(user/assistant)", "content", "message_type(text/image/result_card)", "created_at"],
        "deadlines": ["id", "user_id", "scan_id", "title", "description", "due_date", "reminder_days(int[])", "deadline_type", "status", "auto_created", "created_at"],
        "usage_limits": ["user_id", "month(YYYY-MM)", "scans_count", "questions_per_scan(jsonb)", "PK(user_id, month)"],
        "knowledge_chunks": ["id", "content", "metadata(jsonb)", "embedding(vector(1536))"]
      },
      "rpc_functions": [
        "match_knowledge_chunks(query_embedding, filter_category, threshold, count)",
        "increment_scan_count(p_user_id, p_month)",
        "increment_chat_count(p_user_id, p_scan_id, p_month)"
      ],
      "triggers": ["on_auth_user_created (auto-create profile)", "profiles_touch (updated_at)"]
    },
    "testing": {
      "unit_tests": {
        "framework": "pytest + pytest-asyncio",
        "count": 192,
        "passing": 192,
        "coverage_percent": 87,
        "test_files": [
          "test_auth.py", "test_embeddings.py", "test_explain.py",
          "test_health.py", "test_ocr.py", "test_routers_chat.py",
          "test_routers_deadlines.py", "test_routers_limits.py",
          "test_routers_profile.py", "test_routers_scan.py",
          "test_schemas.py", "test_validator.py"
        ]
      }
    }
  },

